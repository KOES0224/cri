{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/cron/webinar?job=phone-ask",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/webinar?job=phone-ask&run=retry",
      "schedule": "10 1 * * *"
    },
    {
      "path": "/api/cron/webinar?job=reminders&slot=evening",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/webinar?job=reminders&slot=evening-retry",
      "schedule": "10 10 * * *"
    },
    {
      "path": "/api/cron/webinar?job=reminders&slot=morning",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/webinar?job=reminders&slot=morning-retry",
      "schedule": "40 0 * * *"
    }
  ]
}
